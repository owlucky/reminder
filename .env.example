# Скопируйте в .env и заполните значения.

# Токен Telegram-бота (получить у @BotFather). Нужен процессу-воркеру, не сервису.
# Второй бот — отдельный процесс с TELEGRAM_BOT_TOKEN_2.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKEN_2=

# Куда воркер ходит за задачами и куда бот пишет напоминания.
SERVICE_URL=http://127.0.0.1:8000

# Общий секрет сервиса и воркеров (заголовок X-Internal-Token).
# Пусто — внутреннее API без проверки. Задайте, если порт 8000 доступен не только вам.
INTERNAL_TOKEN=

# Необязательный стабильный id процесса-воркера. Пусто — сгенерируется.
# WORKER_ID=

# База данных. По умолчанию — локальный SQLite-файл (легковесно, без внешних зависимостей).
# Файл открывает только сервис. Воркеры к нему не подключаются.
DATABASE_URL=sqlite:///./data/reminders.db

# Как часто сервис формулирует задачи по наступившим напоминаниям (в секундах).
POLL_INTERVAL_SECONDS=30

# Как часто воркер спрашивает распределитель, есть ли задача (в секундах).
WORKER_POLL_SECONDS=1

# На сколько секунд воркер арендует задачу. Не сдал результат — задача вернётся в очередь.
TASK_LEASE_SECONDS=60

# Сколько неудачных доставок, после которых задача помечается failed.
MAX_DELIVERY_ATTEMPTS=5

# На сколько секунд назад "досылать" пропущенные напоминания (например, после простоя/рестарта).
# По умолчанию 6 часов. Дедупликация не даст отправить одно и то же дважды.
MISSED_GRACE_SECONDS=21600

# Срок временного отключения по умолчанию (в днях) для действия snooze ("не напоминать месяц").
DEFAULT_SNOOZE_DAYS=30

# Уровень логирования.
LOG_LEVEL=INFO
